{% extends 'base.html.twig' %}

{% block title %}Book index{% endblock %}

{% block body %}
    <h1 class="page-title">Book index</h1>

    <div class="table-responsive">
    <table class="table table-striped table-hover align-middle table-responsive-stack">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Author</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td data-label="Id">{{ book.id }}</td>
                <td data-label="Title">{{ book.title }}</td>
                <td data-label="Author">{{ book.author }}</td>
                <td data-label="Description">{{ book.description }}</td>
                <td data-label="Actions">
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_book_show', {'id': book.id}) }}">show</a>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_book_edit', {'id': book.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>

    <div class="mt-3">
        <a class="btn btn-primary" href="{{ path('app_book_new') }}">Create new</a>
    </div>
{% endblock %}
